{
  "commands": [
    {
      "id": "ORDER-BY-FORMULA",
      "displayName": "ORDER BY FORMULA",
      "kind": "classic_command",
      "theme": "Queries",
      "overloads": [
        {
          "params": [
            {
              "name": "aTable",
              "type": {
                "kind": "concrete",
                "name": "Table"
              },
              "direction": "in",
              "optional": false
            },
            {
              "name": "group",
              "members": [
                {
                  "name": "formula",
                  "type": {
                    "kind": "pseudo",
                    "name": "Expression"
                  },
                  "direction": "in",
                  "optional": false
                },
                {
                  "name": "order",
                  "type": {
                    "kind": "literal_symbols",
                    "symbols": [
                      ">",
                      "<"
                    ]
                  },
                  "direction": "in",
                  "optional": true
                }
              ],
              "cardinality": {
                "min": 0,
                "max": null
              },
              "position": "trailing"
            }
          ],
          "semanticRole": "ORDER BY FORMULA sorts (reorders) the records of the current selection of aTable for the current process."
        }
      ],
      "constraints": [
        "aTable must be explicitly specified; the default table cannot be used.",
        "Parameters ($1...$n) are not supported inside formula.",
        "If used with PRINT SELECTION and BREAK LEVEL and a local variable, all three must execute from the same method or an error occurs at reevaluation time."
      ]
    },
