{
  "id": "ST-Get-content-type",
  "displayName": "ST Get content type",
  "kind": "classic_command",
  "theme": "Styled-Text",
  "overloads": [
    {
      "params": [
        {
          "name": "asObjectName",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If present, 'object' below is an object name (pass a string); if omitted, 'object' is a Variable/Field reference."
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Object name (if '*' passed) or Variable/field reference (if '*' omitted)"
        },
        {
          "name": "startSel",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Start of selection"
        },
        {
          "name": "endSel",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "End of selection"
        },
        {
          "name": "startBlock",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": true,
          "description": "Start position of first type of selection"
        },
        {
          "name": "endBlock",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": true,
          "description": "End position of first type of selection"
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Integer"
      },
      "semanticRole": "Returns a code identifying the type of content (plain text, expression, URL, picture, etc.) found at the start of a text selection in the designated styled-text object."
    }
  ]
}