{
  "id": "ST-COMPUTE-EXPRESSIONS",
  "displayName": "ST COMPUTE EXPRESSIONS",
  "kind": "classic_command",
  "theme": "Styled-Text",
  "overloads": [
    {
      "params": [
        {
          "name": "asObjectName",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If present, 'object' below is an object name (pass a string); if omitted, 'object' is a Variable/Field reference."
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Object name (if '*' passed) or Variable/field reference (if '*' omitted)"
        },
        {
          "name": "startSel",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Start of selection"
        },
        {
          "name": "endSel",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "End of selection"
        }
      ],
      "semanticRole": "Re-evaluates and re-displays the current value of any dynamic 4D expressions found in the designated multi-style/4D Write Pro object, without altering the styled text itself."
    }
  ]
}