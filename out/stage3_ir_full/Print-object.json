{
  "id": "Print-object",
  "displayName": "Print object",
  "kind": "classic_command",
  "theme": "Printing",
  "overloads": [
    {
      "params": [
        {
          "name": "*",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If specified, object is an object name (Text)."
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Object name (if '*' is specified) or a Variable/Field reference (if '*' is omitted)."
        },
        {
          "name": "posX",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Horizontal location of object."
        },
        {
          "name": "posY",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Vertical location of object."
        },
        {
          "name": "width",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Width of object in pixels."
        },
        {
          "name": "height",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Height of object in pixels."
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Boolean"
      },
      "discriminatedBy": {
        "param": "*",
        "rule": "When '*' is passed, object is an object name (Text) identifying the target by name; when '*' is omitted, object must be a direct Variable or Field reference."
      }
    }
  ],
  "constraints": [
    "Returns True if the object was printed entirely, False otherwise (e.g. not enough room left on the page)."
  ]
}