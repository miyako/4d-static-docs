{
  "id": "OBJECT-GET-COORDINATES",
  "displayName": "OBJECT GET COORDINATES",
  "kind": "classic_command",
  "theme": "Objects-Forms",
  "overloads": [
    {
      "params": [
        {
          "name": "asObjectName",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If present, object below is the name of the form object (string); if omitted, object is a variable or field reference."
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Object name (if * is specified) or Variable or field (if * is omitted)"
        },
        {
          "name": "left",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": false,
          "description": "Left coordinate of the object"
        },
        {
          "name": "top",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": false,
          "description": "Top coordinate of the object"
        },
        {
          "name": "right",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": false,
          "description": "Right coordinate of the object"
        },
        {
          "name": "bottom",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": false,
          "description": "Bottom coordinate of the object"
        }
      ],
      "semanticRole": "The OBJECT GET COORDINATES command returns the coordinates left , top , right and bottom (in points) in variables or fields of the object(s) of the current form defined by the parameters * and object ."
    }
  ]
}