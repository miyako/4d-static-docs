            {
              "value": -1,
              "meaning": "qr title -- title area of the report"
            },
            {
              "value": -2,
              "meaning": "qr detail -- detail area of the report"
            },
            {
              "value": -3,
              "meaning": "qr grand total -- grand total area"
            }
          ]
        },
        {
          "name": "hide",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
