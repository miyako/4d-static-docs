{
  "id": "SET-MENU-ITEM",
  "displayName": "SET MENU ITEM",
  "kind": "classic_command",
  "theme": "Menus",
  "overloads": [
    {
      "params": [
        {
          "name": "menu",
          "type": [
            {
              "kind": "concrete",
              "name": "Integer"
            },
            {
              "kind": "concrete",
              "name": "Text"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Menu number, or a MenuRef menu ID (Text)."
        },
        {
          "name": "menuItem",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "sentinelValues": [
            {
              "value": -1,
              "meaning": "the last item added to the menu"
            }
          ]
        },
        {
          "name": "itemText",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "process",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true
        },
        {
          "name": "*",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If omitted, metacharacters in itemText (e.g. '(', ';', '!', '<B') are interpreted as formatting/instruction characters (as in APPEND MENU ITEM). If passed, those characters are treated as standard literal characters."
        }
      ]
    }
  ],
  "constraints": [
    "If a MenuRef is passed in menu, the process parameter serves no purpose and is ignored.",
    "If the process parameter is omitted, the command applies to the menu bar of the current process."
  ]
}