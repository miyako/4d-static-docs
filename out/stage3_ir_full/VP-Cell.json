{
  "id": "VP-Cell",
  "displayName": "VP Cell",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "column",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "row",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Object"
      },
      "semanticRole": "The VP Cell command returns a new range object referencing a specific cell."
    }
  ],
  "constraints": [
    "Errors if vpAreaName does not designate an existing 4D View Pro area.",
    "Intended for single-cell ranges only; use VP Cells for a range spanning multiple cells.",
    "If sheet is omitted, or vk current sheet is passed, the currently displayed spreadsheet is used."
  ]
}