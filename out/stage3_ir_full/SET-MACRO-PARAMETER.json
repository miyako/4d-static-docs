{
  "id": "SET-MACRO-PARAMETER",
  "displayName": "SET MACRO PARAMETER",
  "kind": "classic_command",
  "theme": "Tools",
  "overloads": [
    {
      "params": [
        {
          "name": "selector",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "sentinelValues": [
            {
              "value": 1,
              "meaning": "replace the full method text"
            },
            {
              "value": 2,
              "meaning": "replace only the highlighted (selected) method text"
            }
          ]
        },
        {
          "name": "textParam",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        }
      ]
    }
  ],
  "constraints": [
    "If no text is currently selected in the method, textParam is simply inserted at the insertion point (selector has no effect)."
  ]
}