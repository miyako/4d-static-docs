{
  "id": "OBJECT-SET-MINIMUM-VALUE",
  "displayName": "OBJECT SET MINIMUM VALUE",
  "kind": "classic_command",
  "theme": "Objects-Forms",
  "overloads": [
    {
      "params": [
        {
          "name": "asObjectName",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If specified, object is an object name (string); if omitted, object is a variable or a field."
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Object name (if * is specified) or Variable or field (if * is omitted)"
        },
        {
          "name": "minValue",
          "type": [
            {
              "kind": "concrete",
              "name": "Date"
            },
            {
              "kind": "concrete",
              "name": "Time"
            },
            {
              "kind": "concrete",
              "name": "Real"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Minimum value for object"
        }
      ],
      "semanticRole": "Sets, for the current process, the minimum-value constraint of the number/date/time object(s) designated by object and *."
    }
  ],
  "constraints": [
    "minValue's type must match the object's underlying data type, otherwise error 18 'Field types are incompatible' is generated."
  ]
}