{
  "id": "Get-menu-item-style",
  "displayName": "Get menu item style",
  "kind": "classic_command",
  "theme": "Menus",
  "overloads": [
    {
      "params": [
        {
          "name": "menu",
          "type": [
            {
              "kind": "concrete",
              "name": "Integer"
            },
            {
              "kind": "concrete",
              "name": "Text"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Menu number or menu reference (MenuRef)."
        },
        {
          "name": "menuItem",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "sentinelValues": [
            {
              "value": -1,
              "meaning": "the last item added to menu"
            }
          ]
        },
        {
          "name": "process",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Process reference number; defaults to the current process if omitted."
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Integer"
      },
      "semanticRole": "Get the current font style (bold/italic/underline combination) of a menu item."
    }
  ],
  "constraints": [
    "If menu is a MenuRef (menu reference), the process parameter is unnecessary and is ignored if passed.",
    "Return value is a combination (sum) of Font Styles theme constants: Plain=0, Bold=1, Italic=2, Underline=4."
  ]
}