{
  "id": "VP-Get-show-print-lines",
  "displayName": "VP Get show print lines",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Boolean"
      },
      "semanticRole": "Returns True if print preview lines are visible in the designated (or current) sheet, False otherwise."
    }
  ],
  "constraints": [
    "sheet is 0-based; if omitted, the command applies to the current sheet."
  ]
}