{
  "id": "VP-SET-SHEET-OPTIONS",
  "displayName": "VP SET SHEET OPTIONS",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false,
          "description": "4D View Pro area name"
        },
        {
          "name": "sheetOptions",
          "type": {
            "kind": "concrete",
            "name": "Object"
          },
          "direction": "in",
          "optional": false,
          "description": "Sheet option(s) to set; see 4D View Pro sheet options"
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Sheet index (current sheet if omitted)",
          "sentinelValues": [
            {
              "value": "vk current sheet",
              "meaning": "Explicitly designates the current spreadsheet (same as omitting sheet)."
            }
          ]
        }
      ],
      "semanticRole": "The VP SET SHEET OPTIONS command allows defining various sheet options of the vpAreaName area."
    }
  ],
  "constraints": [
    "If vpAreaName does not exist, an error is returned."
  ]
}