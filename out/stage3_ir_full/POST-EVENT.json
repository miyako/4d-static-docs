{
  "id": "POST-EVENT",
  "displayName": "POST EVENT",
  "kind": "classic_command",
  "theme": "User Interface",
  "overloads": [
    {
      "params": [
        {
          "name": "what",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "message",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "when",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "mouseX",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "mouseY",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "modifiers",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "process",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true
        }
      ],
      "semanticRole": "The POST EVENT command simulates a keyboard or mouse event.",
      "jointConstraints": [
        {
          "params": [
            "what",
            "message"
          ],
          "rule": "If what designates a mouse-related event (Mouse down/Mouse up), message must be 0 (zero); if what designates a keyboard-related event (Key down/Key up/Auto key), message must hold the code of the simulated character."
        },
        {
          "params": [
            "what",
            "mouseX",
            "mouseY"
          ],
          "rule": "mouseX/mouseY only carry meaningful click coordinates when what is a mouse-related event."
        }
      ]
    }
  ],
  "constraints": [
    "when is normally the value returned by Tickcount.",
    "modifiers takes one or a combination of the Events (Modifiers) theme constants.",
    "If process is 0 or omitted, the event is posted at the application level and dispatched by the 4D scheduler to the appropriate process."
  ]
}