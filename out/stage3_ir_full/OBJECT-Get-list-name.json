{
  "id": "OBJECT-Get-list-name",
  "displayName": "OBJECT Get list name",
  "kind": "classic_command",
  "theme": "Objects-Forms",
  "overloads": [
    {
      "params": [
        {
          "name": "*",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false
        },
        {
          "name": "listType",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "default": "0 (Choice list)"
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Text"
      },
      "semanticRole": "Returns the name of the choice/required/excluded list (selected via listType, default Choice list) associated with the designated form object, or an empty string if none of that type is defined.",
      "discriminatedBy": {
        "param": "*",
        "rule": "When '*' is passed, object is an object name (Text) identifying the target by name; when '*' is omitted, object must be a direct Variable or Field reference."
      }
    }
  ]
}