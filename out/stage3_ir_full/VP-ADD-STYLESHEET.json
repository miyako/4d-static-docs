{
  "id": "VP-ADD-STYLESHEET",
  "displayName": "VP ADD STYLESHEET",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "styleName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "styleObj",
          "type": {
            "kind": "concrete",
            "name": "Object"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true
        }
      ],
      "semanticRole": "The VP ADD STYLESHEET command creates or modifies the styleName style sheet based upon the combination of the properties specified in styleObj in the open document."
    }
  ],
  "constraints": [
    "Errors if vpAreaName does not designate an existing 4D View Pro area.",
    "If a style sheet with the same name and index already exists, it is overwritten with the new values; the same name can be reused across different scopes."
  ]
}