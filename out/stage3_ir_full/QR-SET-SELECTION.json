{
  "id": "QR-SET-SELECTION",
  "displayName": "QR SET SELECTION",
  "kind": "classic_command",
  "theme": "Quick Report",
  "overloads": [
    {
      "params": [
        {
          "name": "area",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "description": "Reference of the area"
        },
        {
          "name": "left",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "description": "Left boundary column number",
