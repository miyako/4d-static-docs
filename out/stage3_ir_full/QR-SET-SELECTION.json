            {
              "value": -1,
              "meaning": "Part of the all-(-1) combination that clears the selection"
            }
          ]
        },
        {
          "name": "top",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "description": "Top boundary row number",
          "sentinelValues": [
            {
              "value": 0,
              "meaning": "Selects the entire column"
            },
            {
              "value": -1,
              "meaning": "Part of the all-(-1) combination that clears the selection"
            }
          ]
        },
        {
          "name": "right",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Right boundary column number"
        },
        {
          "name": "bottom",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Bottom boundary row number"
        }
