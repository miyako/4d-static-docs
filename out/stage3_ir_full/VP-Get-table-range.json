{
  "id": "VP-Get-table-range",
  "displayName": "VP Get table range",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "tableName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "onlyData",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "sentinelValues": [
            {
              "value": 0,
              "meaning": "vk table full range: cell range for the table area including footer and header (default)."
            },
            {
              "value": 1,
              "meaning": "vk table data range: cell range for the table data area only."
            }
          ]
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Object"
      },
      "semanticRole": "Returns the range object of tableName, either the full table area (with header/footer) or the data-only area depending on onlyData."
    }
  ],
  "constraints": [
    "sheet is 0-based; if omitted, the command applies to the current sheet.",
    "Returns null if tableName is not found."
  ]
}