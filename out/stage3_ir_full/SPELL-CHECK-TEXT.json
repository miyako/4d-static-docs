{
  "id": "SPELL-CHECK-TEXT",
  "displayName": "SPELL CHECK TEXT",
  "kind": "classic_command",
  "theme": "Spell Checker",
  "overloads": [
    {
      "params": [
        {
          "name": "text",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "errPos",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": false
        },
        {
          "name": "errLength",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": false
        },
        {
          "name": "checkPos",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "arrSuggest",
          "type": {
            "kind": "concrete",
            "name": "Text array"
          },
          "direction": "out",
          "optional": true
        }
      ]
    }
  ],
  "constraints": [
    "The check scans forward from checkPos and stops at the first unknown word found (if any).",
