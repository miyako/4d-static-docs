        },
        {
          "name": "group",
          "members": [
            {
              "name": "option",
              "type": {
                "kind": "concrete",
                "name": "Integer"
              },
              "direction": "in",
              "optional": false,
              "description": "Option to get"
            },
            {
              "name": "value",
              "type": {
                "kind": "concrete",
                "name": "Integer"
              },
              "direction": "out",
              "optional": false,
              "description": "Current value of option"
            }
          ],
          "cardinality": {
            "min": 0,
            "max": null
          },
          "position": "trailing"
        }
      ],
      "semanticRole": "Reads one or more current operating-option values for the designated styled-text field/variable into caller-supplied variables."
    }
  ]
