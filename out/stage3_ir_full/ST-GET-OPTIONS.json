{
  "id": "ST-GET-OPTIONS",
  "displayName": "ST GET OPTIONS",
  "kind": "classic_command",
  "theme": "Styled-Text",
  "overloads": [
    {
      "params": [
        {
          "name": "asObjectName",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
