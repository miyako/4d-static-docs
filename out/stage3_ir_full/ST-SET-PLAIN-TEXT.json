{
  "id": "ST-SET-PLAIN-TEXT",
  "displayName": "ST SET PLAIN TEXT",
  "kind": "classic_command",
  "theme": "Styled-Text",
  "overloads": [
    {
      "params": [
        {
          "name": "asObjectName",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If present, 'object' below is an object name (pass a string); if omitted, 'object' is a Variable/Field reference."
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Object name (if '*' passed) or Variable/field reference (if '*' omitted)"
        },
        {
          "name": "newText",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false,
          "description": "Text to insert"
        },
        {
          "name": "startSel",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Start of selection"
        },
        {
          "name": "endSel",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "End of selection"
        }
      ],
      "semanticRole": "Replaces a plain-text selection of the designated styled-text object with newText, without inserting or preserving any style tags; the < > & characters in newText are treated as literal characters, not tag delimiters."
    }
  ]
}