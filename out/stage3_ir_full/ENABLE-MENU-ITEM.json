{
  "id": "ENABLE-MENU-ITEM",
  "displayName": "ENABLE MENU ITEM",
  "kind": "classic_command",
  "theme": "Menus",
  "overloads": [
    {
      "params": [
        {
          "name": "menu",
          "type": [
            {
              "kind": "concrete",
              "name": "Integer"
            },
            {
              "kind": "concrete",
              "name": "Text"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Menu number or MenuRef"
        },
        {
          "name": "menuItem",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "sentinelValues": [
            {
              "value": -1,
              "meaning": "the last item added to the menu"
            },
            {
              "value": 0,
              "meaning": "all items of the menu at once"
            }
          ]
        },
        {
          "name": "process",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Process reference number; if omitted, applies to the menu bar of the current process"
        }
      ],
      "semanticRole": "Enables (makes selectable) the specified menu item, or all items of a submenu/menu, in a given process's menu bar."
    }
  ],
  "constraints": [
    "If menu is passed as a MenuRef, the process parameter is ignored."
  ]
}