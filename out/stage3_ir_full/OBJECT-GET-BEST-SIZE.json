{
  "id": "OBJECT-GET-BEST-SIZE",
  "displayName": "OBJECT GET BEST SIZE",
  "kind": "classic_command",
  "theme": "Objects-Forms",
  "overloads": [
    {
      "params": [
        {
          "name": "asObjectName",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If present, object below is the name of the form object (string); if omitted, object is a variable or field reference."
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Object name (if * is specified) or Variable or field (if * is omitted)"
        },
        {
          "name": "bestWidth",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": false,
