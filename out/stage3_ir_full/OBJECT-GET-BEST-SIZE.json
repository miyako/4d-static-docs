            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Maximum object width"
        }
      ],
      "semanticRole": "The OBJECT GET BEST SIZE command returns the bestWidth and bestHeight parameters, the \u201coptimal\u201d width and height of the form object designated by the * and object parameters."
