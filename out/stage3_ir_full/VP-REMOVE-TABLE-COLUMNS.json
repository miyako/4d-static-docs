{
  "id": "VP-REMOVE-TABLE-COLUMNS",
  "displayName": "VP REMOVE TABLE COLUMNS",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "tableName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "column",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "count",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true
        }
      ],
      "semanticRole": "The VP REMOVE TABLE COLUMNS command removes one or count column(s) in the specified tableName at the specified column index."
    }
  ],
  "constraints": [
    "count must be greater than 0.",
    "Columns are removed from the tableName table, not from the sheet; the sheet's total column count is unaffected.",
    "Data to the right of the table (if any) is automatically shifted left by the number of removed columns.",
    "If tableName does not exist, the command does nothing."
  ]
}