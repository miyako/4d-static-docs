{
  "id": "VP-Get-table-column-index",
  "displayName": "VP Get table column index",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "tableName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "columnName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "sentinelValues": [
            {
              "value": -1,
              "meaning": "Same as omitting the parameter: applies to the current sheet."
            }
          ]
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Integer"
      },
      "semanticRole": "Returns the index of the column named columnName within tableName, or -1 if not found."
    }
  ],
  "constraints": [
    "sheet is 0-based; if omitted or -1 is passed, the command applies to the current sheet.",
    "Returns -1 if tableName or columnName is not found."
  ]
}