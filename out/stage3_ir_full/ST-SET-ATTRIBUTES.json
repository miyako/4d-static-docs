{
  "id": "ST-SET-ATTRIBUTES",
  "displayName": "ST SET ATTRIBUTES",
  "kind": "classic_command",
  "theme": "Styled-Text",
  "overloads": [
    {
      "params": [
        {
          "name": "asObjectName",
          "type": {
            "kind": "literal_symbols",
            "symbols": [
              "*"
            ]
          },
          "direction": "in",
          "optional": true,
          "description": "If present, 'object' below is an object name (pass a string); if omitted, 'object' is a Variable/Field reference."
        },
        {
          "name": "object",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Variable"
            },
            {
              "kind": "concrete",
              "name": "Field"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "Object name (if '*' passed) or Variable/field reference (if '*' omitted)"
        },
        {
          "name": "startSel",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "description": "Start of new text selection"
        },
        {
          "name": "endSel",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "description": "End of new text selection"
        },
        {
          "name": "attribName",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "description": "Attribute to set"
        },
        {
          "name": "attribValue",
          "type": [
            {
              "kind": "concrete",
              "name": "Text"
            },
            {
              "kind": "concrete",
              "name": "Integer"
            }
          ],
          "direction": "in",
          "optional": false,
          "description": "New value of attribute"
        },
        {
          "name": "group",
          "members": [
            {
              "name": "attribName",
              "type": {
                "kind": "concrete",
                "name": "Integer"
              },
              "direction": "in",
              "optional": false,
              "description": "Attribute to set"
            },
            {
              "name": "attribValue",
              "type": [
                {
                  "kind": "concrete",
                  "name": "Text"
                },
                {
                  "kind": "concrete",
                  "name": "Integer"
                }
              ],
              "direction": "in",
              "optional": false,
              "description": "New value of attribute"
            }
          ],
          "cardinality": {
            "min": 0,
            "max": null
          },
          "position": "trailing"
        }
      ],
      "semanticRole": "Sets one or more style-attribute values on a text selection of the designated multi-style text object."
    }
  ],
  "constraints": [
    "While the target object has keyboard focus, changes apply only to the object being edited and are transferred to its data source (and any other objects sharing it) only when the object is validated (focus lost or Enter key); while it does not have focus, changes are applied directly to the data source and propagate immediately."
  ]
}