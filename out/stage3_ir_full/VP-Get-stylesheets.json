{
  "id": "VP-Get-stylesheets",
  "displayName": "VP Get stylesheets",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "sentinelValues": [
            {
              "value": "vk current sheet",
              "meaning": "Use the current spreadsheet (default when sheet is omitted)."
            },
            {
              "value": "vk workbook",
              "meaning": "Apply to the whole workbook rather than a single sheet."
            }
          ]
        }
      ],
      "returns": {
        "kind": "concrete",
        "name": "Collection"
      },
      "semanticRole": "Returns the collection of style sheet objects defined in the designated sheet (or scope)."
    }
  ],
  "constraints": [
    "vpAreaName must name an existing 4D View Pro area; an unknown name raises an error."
  ]
}