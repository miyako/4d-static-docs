{
  "id": "GET-FIELD-PROPERTIES",
  "displayName": "GET FIELD PROPERTIES",
  "kind": "classic_command",
  "theme": "Structure Access",
  "overloads": [
    {
      "params": [
        {
          "name": "fieldPtr",
          "type": {
            "kind": "concrete",
            "name": "Pointer"
          },
          "direction": "in",
          "optional": false,
          "description": "Field pointer"
        },
        {
          "name": "fieldType",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": false,
          "description": "Type of field (see the Field and Variable Types theme constants)"
        },
        {
          "name": "fieldLength",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "out",
          "optional": true,
          "description": "Length of the field, if alphanumeric"
        },
        {
          "name": "indexed",
          "type": {
            "kind": "concrete",
            "name": "Boolean"
          },
          "direction": "out",
          "optional": true,
          "description": "True = indexed, False = non-indexed"
        },
        {
          "name": "unique",
          "type": {
            "kind": "concrete",
            "name": "Boolean"
          },
          "direction": "out",
          "optional": true,
          "description": "True = unique, False = non-unique"
        },
        {
