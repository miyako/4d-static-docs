{
  "id": "VP-SET-COLUMN-COUNT",
  "displayName": "VP SET COLUMN COUNT",
  "kind": "classic_command",
  "theme": "4D-View-Pro",
  "overloads": [
    {
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false,
          "description": "4D View Pro area form object name"
        },
        {
          "name": "columnCount",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "description": "Number of columns; must be greater than 0"
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Sheet index (current sheet if omitted)",
          "sentinelValues": [
            {
              "value": "vk current sheet",
              "meaning": "Explicitly target the current spreadsheet."
            }
          ]
        }
      ],
      "semanticRole": "The VP SET COLUMN COUNT command defines the total number of columns in vpAreaName ."
    }
  ],
  "constraints": [
    "columnCount must be greater than 0."
  ]
}