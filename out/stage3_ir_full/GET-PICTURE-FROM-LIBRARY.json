{
  "id": "GET-PICTURE-FROM-LIBRARY",
  "displayName": "GET PICTURE FROM LIBRARY",
  "kind": "classic_command",
  "theme": "Pictures",
  "overloads": [
    {
      "params": [
        {
          "name": "picRef",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "picture",
          "type": {
            "kind": "concrete",
            "name": "Picture"
          },
          "direction": "out",
          "optional": false
        }
      ],
      "semanticRole": "Retrieves a Picture Library graphic identified by its reference number."
    },
    {
      "params": [
        {
          "name": "picName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false
        },
        {
          "name": "picture",
          "type": {
            "kind": "concrete",
            "name": "Picture"
          },
          "direction": "out",
          "optional": false
        }
      ],
      "semanticRole": "Retrieves a Picture Library graphic identified by its name."
    }
  ],
  "constraints": [
    "Cannot be used in project-mode databases; the Picture Library is only available in binary databases.",
    "If no picture matches the given picRef/picName, picture is left unchanged."
  ]
}