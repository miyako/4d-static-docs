          "description": "Message to sign"
        },
        {
          "name": "options",
          "type": {
            "kind": "concrete",
            "name": "Object"
          },
          "direction": "in",
          "optional": false,
          "description": "Signing options"
        }
      ],
      "rawSyntax": ".**sign** (*message* : Text ; *options* : Object) : Text",
      "returns": {
        "kind": "concrete",
        "name": "Text"
      }
    },
