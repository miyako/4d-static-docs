          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false,
          "description": "Message string to be encoded using `options.encodingDecrypted` and encrypted."
        },
        {
          "name": "options",
          "type": {
            "kind": "concrete",
            "name": "Object"
          },
          "direction": "in",
          "optional": false,
          "description": "Encoding options"
        }
      ],
      "rawSyntax": "**.encrypt**( *message* : Text ; *options* : Object ) : Text",
      "returns": {
        "kind": "concrete",
        "name": "Text"
      }
    }
