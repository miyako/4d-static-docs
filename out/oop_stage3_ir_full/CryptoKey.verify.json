          "name": "message",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false,
          "description": "Message that was used to produce the signature"
        },
        {
          "name": "signature",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false,
          "description": "Signature to verify, in Base64 or Base64URL representation, depending on `options.encoding` value"
        },
        {
          "name": "options",
          "type": {
            "kind": "concrete",
            "name": "Object"
          },
          "direction": "in",
          "optional": false,
          "description": "Signing options"
        }
      ],
      "rawSyntax": "**.verify**( *message* : Text ; *signature* : Text ; *options* : Object) : Object",
