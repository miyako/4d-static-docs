        },
        {
          "name": "options",
          "type": {
            "kind": "concrete",
            "name": "Object"
          },
          "direction": "in",
          "optional": false,
          "description": "Signing options"
        }
      ],
      "rawSyntax": "*.verify**( *message* : Blob ; *signature* : Text ; *options* : Object) : Object",
