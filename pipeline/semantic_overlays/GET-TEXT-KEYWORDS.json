{
  "constraints": [
    "If the optional * parameter is passed, each distinct word is stored only once in arrKeywords; otherwise every occurrence is stored, even duplicates."
  ],
  "overloadPatches": [
    {
      "index": 0,
      "params": [
        { "name": "text", "type": { "kind": "concrete", "name": "Text" }, "direction": "in", "optional": false },
        { "name": "arrKeywords", "type": { "kind": "concrete", "name": "Text array" }, "direction": "out", "optional": false },
        { "name": "*", "type": { "kind": "literal_symbols", "symbols": ["*"] }, "direction": "in", "optional": true }
      ]
    }
  ]
}
