{
  "theme": "4D-View-Pro",
  "constraints": [
    "An error is returned if vpAreaName does not designate an existing 4D View Pro area.",
    "rowCount must be greater than 0; if omitted, it defaults to 1."
  ],
  "overloadPatches": [
    {
      "index": 0,
      "params": [
        {
          "name": "vpAreaName",
          "type": {
            "kind": "concrete",
            "name": "Text"
          },
          "direction": "in",
          "optional": false,
          "description": "4D View Pro area form object name"
        },
        {
          "name": "row",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": false,
          "description": "Row index (counting begins at 0) of the first row of the range"
        },
        {
          "name": "rowCount",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Total number of rows of the range (default 1); must be greater than 0"
        },
        {
          "name": "sheet",
          "type": {
            "kind": "concrete",
            "name": "Integer"
          },
          "direction": "in",
          "optional": true,
          "description": "Sheet index (current sheet if omitted)",
          "sentinelValues": [
            {
              "value": "vk current sheet",
              "meaning": "Explicitly target the current spreadsheet."
            }
          ]
        }
      ]
    }
  ]
}
