  "subGrammars": {
    "ORDA query string": {
      "description": "4D's own query grammar used by EntitySelection.query() and DataClass.query(): comparison expressions over attribute paths, joined with logical operators, with :N indexed placeholders and :paramName named placeholders standing in for values supplied separately.",
      "syntaxExample": "lastname = :1 and salary > :2",
      "rules": [
        "An attribute path uses dots to traverse related entities and object attributes.",
        "Placeholders are :N (1-based, positional) or :name (resolved from querySettings.parameters).",
        "Passing values as placeholders rather than concatenating them into the string is required to avoid query injection.",
        "Formula placeholders are only evaluated when querySettings.allowFormulas is not False."
      ]
    },
    "Collection query string": {
      "description": "The collection-of-objects query grammar used by Collection.query(): the same comparison/placeholder shape as the ORDA query grammar, but evaluated over object properties of collection elements rather than entity attributes.",
      "syntaxExample": "value > :1 and name = :2",
      "rules": [
        "Property paths may traverse nested objects with dots and arrays with [].",
        "Placeholders are :N (1-based, positional) or :name (resolved from querySettings.parameters)."
      ]
    },
    "Collection order-by string": {
      "description": "The compact ordering DSL accepted by Collection.orderBy(): comma-separated 'propertyPath direction' pairs.",
      "syntaxExample": "long desc, short asc",
      "rules": [
        "Criteria are separated by commas.",
        "Each criterion is a property path optionally followed by 'asc'/'desc' (default ascending).",
        "This is the string form of the same intent expressed structurally by the collection-of-objects overload."
      ]
    }
  },
