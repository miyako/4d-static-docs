        {
          "rawSyntax": "**.query**( *queryString* : Text ; *...value* : any ) : Collection",
          "semanticRole": "query with positional placeholder values",
          "discriminatedBy": {
            "param": "value",
            "rule": "Chosen when the query string contains :N placeholders and values follow positionally."
          },
          "params": [
            {
              "name": "queryString",
              "type": {
                "kind": "subgrammar_ref",
                "grammar": "Collection query string"
              },
