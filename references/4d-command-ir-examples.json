{
  "enums": {
    "FieldVariableType": {
      "description": "Shared 'Field and Variable Types' constants, referenced from many commands (OB Get, WA Evaluate JavaScript, etc.) instead of being inlined per-command.",
      "values": [
        { "name": "Is real", "value": 1, "description": "Real number" },
        { "name": "Is text", "value": 2, "description": "Text" },
        { "name": "Is picture", "value": 3, "description": "Picture" },
        { "name": "Is date", "value": 4, "description": "Date" },
        { "name": "Is Boolean", "value": 6, "description": "Boolean" },
        { "name": "Is longint", "value": 9, "description": "Long integer" },
        { "name": "Is time", "value": 11, "description": "Time" },
        { "name": "Is pointer", "value": 23, "description": "Pointer" },
        { "name": "Is object", "value": 38, "description": "Object" },
        { "name": "Is collection", "value": 42, "description": "Collection" },
        { "name": "Is null", "value": 255, "description": "Null" }
      ]
    }
  },

  "subGrammars": {
    "attributePath": {
      "description": "4D-native sub-grammar used inside Text-typed attributePath parameters (QUERY BY ATTRIBUTE and family). Fully specifiable from 4D's own docs.",
      "syntaxExample": "\"myFirstAttribute.mySecondAttribute\" / \"items[]\" / \"items[i]\"",
      "rules": [
        "Segments are dot-separated; leading/trailing spaces around a segment are trimmed.",
        "A trailing [] on a segment marks that attribute as an array.",
        "An optional single letter inside the brackets (e.g. [i]) names a placeholder for referencing a specific array element in downstream formulas."
      ]
    }
  },

  "foreignGrammars": {
    "SQL": { "language": "SQL", "note": "Embedded in SQL EXECUTE / SQL SET PARAMETER string arguments.", "validatableByThisCorpus": false },
    "Regex": { "language": "Regex", "note": "Embedded in Match regex / Replace string pattern arguments.", "validatableByThisCorpus": false }
  },

  "protocols": {
    "multiCallChains": {
      "queryThemeChain": {
        "description": "Repeated calls build up a multi-level sort/query; a trailing '*' means more calls are coming, its absence on the final call triggers execution.",
        "leadingDiscriminatorParam": "conjOp",
        "continuationParam": "*",
        "usedByCommands": ["ORDER-BY", "ORDER-BY-ATTRIBUTE", "QUERY-BY-ATTRIBUTE", "QUERY-SELECTION-BY-ATTRIBUTE"],
        "example": "ORDER BY([Inv];[Inv]type;>;[Inv]product;>;*)\nORDER BY([Inv];[Inv]desc;>)  // final call, no *, triggers the sort"
      }
    },
    "stateMachines": {
      "saxParsing": {
        "description": "SAX-style XML generation: commands must be called in properly nested open/set/close order across the whole method.",
        "states": ["idle", "in_element"],
        "entryCommands": ["SAX-OPEN-XML-ELEMENT"],
        "exitCommands": ["SAX-CLOSE-XML-ELEMENT"],
        "transitions": [
          { "from": "idle", "to": "in_element", "viaCommand": "SAX-OPEN-XML-ELEMENT" },
          { "from": "in_element", "to": "in_element", "viaCommand": "SAX-SET-XML-ATTRIBUTE" },
          { "from": "in_element", "to": "idle", "viaCommand": "SAX-CLOSE-XML-ELEMENT" }
        ]
      }
    }
  },

  "handleTypes": {
    "SAXContext": {
      "description": "Opaque parsing/generation context threaded through the SAX command family.",
      "producedBy": ["SAX-OPEN-XML-ELEMENT"],
      "consumedBy": ["SAX-SET-XML-ATTRIBUTE", "SAX-CLOSE-XML-ELEMENT"],
      "destroyedBy": ["SAX-CLOSE-XML-ELEMENT"]
    }
  },

  "callbackContracts": {
    "onErrCallHandler": {
      "description": "Expected calling convention for a method registered via ON ERR CALL — invoked automatically by 4D when an error occurs, not called directly by user code.",
      "trigger": "A runtime error occurs while this handler is active.",
      "expectedParams": []
    }
  },

  "commands": [

    {
      "id": "ORDER-BY-FORMULA",
      "displayName": "ORDER BY FORMULA",
      "kind": "classic_command",
      "theme": "Queries",
      "overloads": [
        {
          "params": [
            { "name": "aTable", "type": { "kind": "concrete", "name": "Table" }, "direction": "in", "optional": false },
            {
              "name": "sortLevel",
              "members": [
                { "name": "formula", "type": { "kind": "concrete", "name": "Expression" }, "direction": "in", "optional": false },
                {
                  "name": "order",
                  "type": { "kind": "literal_symbols", "symbols": [">", "<"], "meanings": { ">": "ascending", "<": "descending" } },
                  "direction": "in",
                  "optional": true,
                  "default": ">"
                }
              ],
              "cardinality": { "min": 1, "max": null },
              "position": "embedded"
            }
          ],
          "returns": null
        }
      ],
      "constraints": [
        "aTable must be explicitly specified; the default table cannot be used.",
        "Parameters ($1...$n) are not supported inside formula.",
        "If used with PRINT SELECTION and BREAK LEVEL and a local variable, all three must execute from the same method or an error occurs at reevaluation time."
      ],
      "summary": "Sorts the current selection of aTable using one or more formula-based levels."
    },

    {
      "id": "ORDER-BY",
      "displayName": "ORDER BY",
      "kind": "classic_command",
      "theme": "Queries",
      "overloads": [
        {
          "params": [
            { "name": "aTable", "type": { "kind": "concrete", "name": "Table" }, "direction": "in", "optional": true, "default": "default table if set" },
            {
              "name": "sortLevel",
              "members": [
                { "name": "aField", "type": { "kind": "concrete", "name": "Field" }, "direction": "in", "optional": false },
                { "name": "order", "type": { "kind": "literal_symbols", "symbols": [">", "<"] }, "direction": "in", "optional": true, "default": ">" }
              ],
              "cardinality": { "min": 1, "max": null },
              "position": "embedded"
            },
            { "name": "*", "type": { "kind": "literal_symbols", "symbols": ["*"] }, "direction": "in", "optional": true, "blocksOnOmission": false }
          ],
          "returns": null,
          "jointConstraints": []
        }
      ],
      "protocolRefs": { "multiCallChain": "queryThemeChain" },
      "constraints": [
        "If aField, order, and * are all omitted, ORDER BY displays the interactive Order By editor instead of sorting."
      ]
    },

    {
      "id": "C-LONGINT",
      "displayName": "C_LONGINT",
      "kind": "compiler_directive",
      "theme": "Compiler",
      "overloads": [
        {
          "params": [
            {
              "name": "variable",
