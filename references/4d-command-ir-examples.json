              "position": "embedded"
            }
          ],
          "returns": null,
          "semanticRole": "Declares/types one or more local, process, or interprocess variables as Long Integer.",
          "discriminatedBy": { "param": "method", "rule": "This overload applies when the leading optional 'method' parameter is NOT passed." }
        },
        {
          "params": [
            { "name": "method", "type": { "kind": "concrete", "name": "Method" }, "direction": "in", "optional": false },
            {
              "name": "variable",
              "members": [
                { "name": "variableName", "type": { "kind": "concrete", "name": "Variable" }, "direction": "in", "optional": false }
              ],
              "cardinality": { "min": 1, "max": null },
              "position": "embedded"
            }
          ],
          "returns": null,
          "semanticRole": "Annotates the parameter types of a DIFFERENT, named method's calling convention from outside it (e.g. C_LONGINT($1;$streamRef) declares that $1 of the CURRENT method is Longint).",
          "discriminatedBy": { "param": "method", "rule": "This overload applies when the leading 'method' parameter IS passed." }
        }
      ],
      "constraints": [
        "Must generally appear before first use / at the top of a method.",
        "The C_LONGINT(${N}) variadic-from-position-N form only works in compiled mode; using it in interpreted mode is unsupported."
      ]
    },

