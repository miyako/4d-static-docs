              "sentinelValues": [ { "value": -1, "meaning": "reset to original color" } ] }
          ],
          "returns": null,
          "interactionNotes": [
            { "params": ["asObjectName (leading *)", "itemRef (* sentinel)"], "note": "The literal symbol '*' means two unrelated things depending on position: leading = 'list is a name, not a ref number'; in itemRef's slot = 'operate on the current item'." }
          ]
